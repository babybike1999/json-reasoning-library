  "source_feature_map": {
    "script_execution": [
      "chapter 1 demonstrates Streamlit apps as Python scripts and top-to-bottom rendering with visible changes after saving/rerunning"
    ],
    "widgets": [
      "chapters 1, 2, 4, 6 demonstrate button, selectbox, slider, number_input, text_input, color_picker, sidebar, tabs, columns, and multipage layout"
    ],
    "forms": [
      "chapter 4 demonstrates st.form and st.form_submit_button around grouped ML inputs"
    ],
    "file_workflows": [
      "chapter 2 demonstrates st.file_uploader, CSV reads with pandas, st.stop when no file is present, and download behavior"
    ],
    "caching": [
      "chapter 2 demonstrates st.cache_data for data loading; chapter 4 demonstrates st.cache_resource for a model resource"
    ],
    "visualization": [
      "chapter 3 demonstrates Streamlit charts and third-party visualization libraries"
    ],
    "deployment": [
      "chapter 5 demonstrates GitHub and Streamlit Community Cloud deployment and st.secrets usage"
    ],
    "components": [
      "chapter 7 demonstrates selected community components; these should not be treated as stable/current without verification"
    ]
  },
