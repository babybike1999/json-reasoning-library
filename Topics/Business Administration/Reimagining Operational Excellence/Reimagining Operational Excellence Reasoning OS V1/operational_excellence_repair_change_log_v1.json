  "major_changes": [
    "Removed or rewrote placeholder-like diagnostic and derivation language instead of mechanical replacement.",
    "Collapsed repetitive draft records into fewer high-utility frameworks, applications, workflows, metrics, and risk records.",
    "Created a separate QCDS lens file with four distinct records for quality, cost, delivery, and service.",
    "Rewrote case records to include what happened, why the book uses the case, transfer conditions, evidence before copying, and overgeneralization risk.",
    "Rebuilt diagnostic questions by theme with concrete decisions, evidence, good signs, red flags, and cross-references.",
    "Rebuilt business applications and AI workflows so each has distinct inputs, analysis steps, outputs, unsafe outputs, and human-review triggers.",
    "Attached current-verification flags to specific affected record IDs.",
    "Recalibrated confidence so operational extensions and AI/dashboard uses are often low confidence unless company evidence is provided.",
    "Regenerated compact assistant context and start-here file rather than duplicating the full OS."
  ],
  "removed_or_merged_record_patterns": [
    "placeholder-number diagnostic questions",
    "generic business application skeletons",
    "generic AI workflow skeletons",
    "case examples without a distinct transfer lesson",
    "metrics that looked like invented KPIs rather than categories",
    "empty or weak cross-reference groups"
  ],
